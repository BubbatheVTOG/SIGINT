{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/bubba/AGENTS.md"],
  "provider": {
    "openrouter": {
      "models": {
        "<model-slug>": {
          "options": {
            "provider": {
              "sort": "throughput"
            }
          }
        }
      }
    },
    "vllm": {
      "name": "(local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ai.xorro.tech/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "bubba": {
          "name": "bubba",
          "reasoning": true,
          "limit": {
            "context": 256000,
            "output": 65536
          },
          "options": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0
          },
          "variants": {
            "high": { "disabled": true },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    }
  },
  "compaction": {
    "prune": true,
    "auto": true,
    "reserved": 20000
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      },
      "enabled": true,
      "timeout": 30000
    },
    "htb": {
      "type": "remote",
      "url": "https://mcp.hackthebox.ai/v1/ctf/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:HTB_TOKEN}"
      }
    }
  },
  "tools": {
    "searxng_*": true
  },
  "lsp": {
    "elixir-ls": {
      "command": ["/home/bubba/.local/share/mise/shims/elixir-ls"],
      "extensions": [".ex", ".exs"]
    }
  }
}
