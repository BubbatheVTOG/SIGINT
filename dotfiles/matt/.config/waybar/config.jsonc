{
    "layer": "top",
    "position": "top",
    "height": 48,
    "spacing": 2,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "border-radius": 5,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "pulseaudio",
        "custom/sep1",
        "network",
        "custom/sep2",
        "cpu",
        "custom/sep3",
        "memory",
        "custom/sep4",
        "custom/gpu-status",
        "custom/sep5",
        "clock",
        "tray"
    ],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "on-click": "hyprctl eval 'hl.dsp.focus({ workspace = {id} })'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d}",
        "interval": 60
    },

    "cpu": {
        "format": "CPU {usage:02}% ",
        "tooltip": true,
        "tooltip-format": "CPU Usage: {usage}%\nCores: {avg_frequency} GHz",
        "interval": 2
    },

    "memory": {
        "format": "MEM {}% ",
        "tooltip": true,
        "tooltip-format": "Memory: {used:.1f}GB/{total:.1f}GB\nSwap: {swapUsed:.1f}GB/{swapTotal:.1f}GB",
        "interval": 5
    },

    "network": {
        "format-wifi": "{essid} 📶",
        "format-ethernet": "🌐 {ipaddr}",
        "format-linked": "🔗",
        "format-disconnected": "⚠️",
        "tooltip": true,
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nFrequency: {frequency}MHz\nStrength: {signaldBm}dBm\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}\nGateway: {gwaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor",
        "interval": 10
    },

    "custom/sep1": { "format": "│", "tooltip": false },
    "custom/sep2": { "format": "│", "tooltip": false },
    "custom/sep3": { "format": "│", "tooltip": false },
    "custom/sep4": { "format": "│", "tooltip": false },
    "custom/sep5": { "format": "│", "tooltip": false },

    "custom/gpu-status": {
        "exec": "/home/bubba/.local/bin/gpu-status --json",
        "interval": 10,
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "on-click": "sudo toggle-gpu status"
    },

    "bluetooth": {
        "format": "{status} ",
        "format-connected": "{num_connections} ",
        "format-disabled": "",
        "tooltip": true,
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    }
}
