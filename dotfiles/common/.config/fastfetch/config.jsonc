{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "auto",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "blue"
    }
  },
  "modules": [
    { "type": "title", "key": " " },
    { "type": "os", "key": "OS" },
    { "type": "host", "key": "HOST" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PKGS" },
    { "type": "shell", "key": "SHELL" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "TERM" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEM" },
    { "type": "disk", "key": "DISK" },
    { "type": "battery", "key": "BATT" },
    { "type": "palette", "key": " " }
  ]
}
