{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "orchestrator",
  "plugin": ["opencode-sessions"],
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "order": ["<FAST_PROVIDER_SLUG>", "<CHEAP_PROVIDER_SLUG>"],
              "allow_fallbacks": true
            }
          }
        }
      }
    },
    "vllm": {
      "name": "vllm (www)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://ai.xorro.tech/v1",
		"apiKey": "bubba"
      },
      "models": {
        "bubba": {
          "name": "bubba",
          "limit": {
            "context": 256000,
            "output": 8192
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0
          }
        }
      }
    },
    "llamacpp": {
      "name": "llamacpp (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8081/v1"
      },
      "models": {
        "bubba (local)": {
          "name": "bubba (local)",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 2048
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0.0,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0
          }
        }
      }
    }
  },
  "compaction": {
    "prune": true,
    "auto": true,
    "reserved": 5000
  },
  "mcp": {
    "htb": {
      "type": "remote",
      "url": "https://mcp.hackthebox.ai/v1/ctf/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer REDACTED_HTB_TOKEN"
      }
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng@1.14.1"],
      "environment": {
        "SEARXNG_URL": "http://localhost:8080",
        "SEARCH_CACHE_TTL_MS": "1"
      },
      "enabled": true,
      "timeout": 30000
    },
    "kali": {
      "type": "local",
      "command": ["docker", "exec", "-i", "kali-mcp-server", "mcp-server", "--server", "http://localhost:5000"],
      "enabled": true,
      "timeout": 300000
    },
    "coros": {
      "type": "remote",
      "url": "https://mcpus.coros.com/mcp",
      "enabled": true
    }
  },
  "tools": {
    "searxng_*": true,
    "htb_*": true,
    "nmap_scan": true,
    "gobuster_scan": true,
    "dirb_scan": true,
    "nikto_scan": true,
    "sqlmap_scan": true,
    "metasploit_run": true,
    "hydra_attack": true,
    "john_crack": true,
    "wpscan_analyze": true,
    "enum4linux_scan": true,
    "server_health": true,
    "execute_command": true,
    "ffuf_scan": true,
    "nuclei_scan": true,
    "masscan_scan": true,
    "searchsploit_query": true,
    "whatweb_scan": true,
    "harvester_scan": true,
    "feroxbuster_scan": true,
    "subfinder_scan": true,
    "httpx_probe": true,
    "wafw00f_scan": true
  }
}
