# Personal zsh additions — sourced by grml's zrclocal (~/.zshrc -> grml zshrc).
# Keep this minimal; grml owns prompt, history, aliases, completion.
# Starship is available but intentionally disabled in favor of the grml prompt.
# To re-enable starship, add: eval "$($HOME/.local/bin/starship init zsh)"

# History — grml's guard (HISTSIZE==30 || empty) doesn't fire on zsh 5.9 (default 1000),
# so set explicit values here to keep persistent history.
export HISTSIZE=50000
export SAVEHIST=50000

# opencode — matt uses the npm-global install; sigint may use the official
# ~/.opencode/bin installer. Missing PATH dirs are ignored, so both are safe.
export PATH="$HOME/.npm-global/bin:$HOME/.opencode/bin:$PATH"

# opencode binary path — matt-only workaround for a Bun bus crash on the
# Ryzen 5800X3D. Set only where the npm-installed binary actually exists.
if [ -x "$HOME/.npm-global/lib/node_modules/opencode-ai/bin/opencode.exe" ]; then
    export OPENCODE_BIN_PATH="$HOME/.npm-global/lib/node_modules/opencode-ai/bin/opencode.exe"
fi

# bun completions
[ -s "/home/bubba/.bun/_bun" ] && source "/home/bubba/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Secrets (API keys, tokens) - kept outside the repo
[ -f ~/.config/secrets ] && source ~/.config/secrets

# Neat fetch on every terminal window, tinted to match the active theme
# (teal / red accents from ~/.cache/current_theme, kept in sync by toggle-theme.sh)
if [[ "$TERM" != dumb ]] && command -v fastfetch >/dev/null 2>&1; then
    case "$(cat ~/.cache/current_theme 2>/dev/null)" in
        red)  fastfetch --color-keys '#ef596f' --color-title '#ef596f' \
                        --color-separator '#c24038' --logo-color-1 '#ef596f' ;;
        *)    fastfetch --color-keys '#00ffff' --color-title '#00ffff' \
                        --color-separator '#00cccc' --logo-color-1 '#00ffff' ;;
    esac
fi
