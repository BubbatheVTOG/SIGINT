# Personal zsh additions — sourced by grml's zrclocal (~/.zshrc -> grml zshrc).
# Keep this minimal; grml owns prompt, history, aliases, completion.
# Starship was intentionally disabled in favor of the grml prompt until 2026-08;
# it is now enabled below (see "modern CLI tooling" block at the bottom).

# NOTE: sourced TWICE on hosts where both /etc/zsh/zshrc and ~/.zshrc are grml
# (both run zrclocal). Guard against double-sourcing (double fastfetch, PATH dupes).
[[ -n "${_ZSHRC_LOCAL_SOURCED:-}" ]] && return 0
_ZSHRC_LOCAL_SOURCED=1

# History — grml's guard (HISTSIZE==30 || empty) doesn't fire on zsh 5.9 (default 1000),
# so set explicit values here to keep persistent history.
export HISTSIZE=50000
export SAVEHIST=50000

# opencode — matt uses the npm-global install; sigint may use the official
# ~/.opencode/bin installer. Missing PATH dirs are ignored, so both are safe.
export PATH="$HOME/.npm-global/bin:$HOME/.opencode/bin:$PATH"

# opencode binary path — matt-only workaround for a Bun bus crash on the
# Ryzen 5800X3D. Set only where the npm-installed binary actually exists.
if [ -x "$HOME/.npm-global/lib/node_modules/opencode-ai/bin/opencode.exe" ]; then
    export OPENCODE_BIN_PATH="$HOME/.npm-global/lib/node_modules/opencode-ai/bin/opencode.exe"
fi

# bun completions
[ -s "/home/bubba/.bun/_bun" ] && source "/home/bubba/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Secrets (API keys, tokens) - kept outside the repo
[ -f ~/.config/secrets ] && source ~/.config/secrets

# Neat fetch on every terminal window, tinted to match the active theme.
# Colors come from ~/.config/theme/fastfetch-palette.sh, rewritten by
# toggle-theme.sh on every SUPER+SHIFT+R.  Fallback to teal if missing.
if [[ "$TERM" != dumb ]] && command -v fastfetch >/dev/null 2>&1; then
    if [ -f "$HOME/.config/theme/fastfetch-palette.sh" ]; then
        . "$HOME/.config/theme/fastfetch-palette.sh"
    else
        FF_KEYS='#00ffff'; FF_TITLE='#00ffff'; FF_SEP='#00cccc'; FF_LOGO='#00ffff'
    fi
    fastfetch --color-keys "$FF_KEYS" --color-title "$FF_TITLE" \
              --color-separator "$FF_SEP" --logo-color-1 "$FF_LOGO"
fi

# >>> modern CLI tooling (added by opencode, 2026-08) >>>
# Every line is existence-guarded per the common/ rule: matt (Arch) and
# sigint (Fedora) share this file. Install missing tools via
# ~/git/SIGINT/dotfiles/install-cli-tools.sh.

# Starship prompt
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# zoxide — smarter cd (z / zi)
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# fzf key bindings (Ctrl-R history search, Ctrl-T file insert, Alt-C cd)
for _fzf_bind in /usr/share/fzf/shell/key-bindings.zsh /usr/share/fzf/key-bindings.zsh; do
    [ -f "$_fzf_bind" ] && source "$_fzf_bind" && break
done
unset _fzf_bind

# atuin — searchable shell history (takes over Ctrl-R; keep AFTER fzf)
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

# direnv — per-directory .envrc hooks
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"

# herdr completions (grml compinit runs before zrclocal, so compdef exists here)
if command -v herdr >/dev/null 2>&1; then
    _herdr_comp="$HOME/.config/herdr/completions/_herdr"
    if [ ! -f "$_herdr_comp" ]; then
        mkdir -p "${_herdr_comp:h}"
        herdr completion zsh > "$_herdr_comp" 2>/dev/null
    fi
    if [ -f "$_herdr_comp" ] && (( ${+functions[compdef]} )); then
        source "$_herdr_comp"
    fi
    unset _herdr_comp
fi

# Modern replacements for GNU defaults (interactive aliases only, per-tool guards)
command -v eza >/dev/null 2>&1 && {
    alias ls='eza --group-directories-first'
    alias ll='eza -la --group-directories-first --icons'
    alias la='eza -a --group-directories-first'
}
command -v bat   >/dev/null 2>&1 && alias cat='bat --paging=never'
command -v fd    >/dev/null 2>&1 && alias find='fd'
command -v duf   >/dev/null 2>&1 && alias du='duf'
command -v procs >/dev/null 2>&1 && alias ps='procs'

# <<< modern CLI tooling <<<
